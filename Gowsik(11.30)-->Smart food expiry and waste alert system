def voice_alert(message):
    """Speak an alert using Windows PowerShell speech synthesis."""
    try:
        safe_message = message.replace("'", "''")

        script = (
            "Add-Type -AssemblyName System.Speech; "
            "$speaker = New-Object "
            "System.Speech.Synthesis.SpeechSynthesizer; "
            f"$speaker.Speak('{safe_message}'); "
            "$speaker.Dispose()"
        )

        subprocess.run(
            ["powershell", "-NoProfile", "-Command", script],
            capture_output=True,
            text=True,
            timeout=25,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0)
        )

    except Exception as error:
        print("Voice alert error:", error)


def alert_message(message):
    """Play sound, show desktop notification and speak without freezing Tkinter."""
    try:
        winsound.MessageBeep(winsound.MB_ICONEXCLAMATION)
        winsound.Beep(1000, 500)
    except Exception as error:
        print("Sound alert error:", error)

    try:
        notification.notify(
            title="Smart Food Expiry Alert",
            message=message,
            timeout=15
        )
    except Exception as error:
        print("Desktop notification error:", error)

    # Run speech in a background thread so the GUI remains responsive.
    threading.Thread(
        target=voice_alert,
        args=(message,),
        daemon=True
    ).start()


