    # ------------------------------------------------------
    # 6. DASHBOARD
    # ------------------------------------------------------

    def update_dashboard(self):
        try:
            active = database_query(
                "SELECT COUNT(*) FROM food_items WHERE status='ACTIVE'",
                fetch="one"
            )[0]

            wasted = database_query(
                "SELECT COUNT(*) FROM food_items WHERE status='WASTED'",
                fetch="one"
            )[0]

            expiring = database_query("""
                SELECT COUNT(*)
                FROM food_items
                WHERE status='ACTIVE'
                AND DATEDIFF(expiry_date, CURDATE()) BETWEEN 0 AND %s
            """, (ALERT_DAYS,), fetch="one")[0]

            self.active_label.config(text=str(active))
            self.expiring_label.config(text=str(expiring))
            self.wasted_label.config(text=str(wasted))

        except Error as error:
            self.set_status(f"Dashboard database error: {error}")

    def set_status(self, message):
        self.status_label.config(text=message)

    # ------------------------------------------------------
    # 7. ADD PRODUCT
    # ------------------------------------------------------

    def add_product(self):
        name = self.name_entry.get().strip()
        quantity = self.quantity_entry.get().strip()
        expiry_text = self.expiry_entry.get().strip()

        if not name or not quantity or not expiry_text:
            messagebox.showwarning(
                "Missing Details",
                "Please enter food name, quantity and expiry date."
            )
            return

        if not quantity.isdigit() or int(quantity) <= 0:
            messagebox.showerror(
                "Invalid Quantity",
                "Quantity must be a positive whole number."
            )
            return

        if len(name) > 100:
            messagebox.showerror(
                "Invalid Name",
                "Food name cannot exceed 100 characters."
            )
            return

        try:
            expiry = datetime.strptime(
                expiry_text, "%d-%m-%Y"
            ).date()
        except ValueError:
            messagebox.showerror(
                "Invalid Date",
                "Enter the date in DD-MM-YYYY format."
            )
            return

        if expiry < date.today():
            messagebox.showerror(
                "Invalid Date",
                "Expiry date cannot be earlier than today."
            )
            return

        try:
            duplicate = database_query("""
                SELECT id
                FROM food_items
                WHERE LOWER(name)=LOWER(%s)
                AND expiry_date=%s
                AND status='ACTIVE'
                LIMIT 1
            """, (name, expiry), fetch="one")

            if duplicate:
                messagebox.showwarning(
                    "Duplicate Product",
                    "This active product with the same expiry date already exists."
                )
                return

            database_query("""
                INSERT INTO food_items
                    (name, quantity, expiry_date, status)
                VALUES (%s, %s, %s, 'ACTIVE')
            """, (name, quantity, expiry))

            self.name_entry.delete(0, tk.END)
            self.quantity_entry.delete(0, tk.END)
            self.expiry_entry.delete(0, tk.END)

            self.refresh_products()
            self.update_dashboard()
            self.set_status(f"{name} was saved successfully.")

            messagebox.showinfo(
                "Success",
                "Food product saved successfully."
            )

            self.check_all_expiry()

        except Error as error:
            messagebox.showerror("Database Error", str(error))

    # ------------------------------------------------------
    # 8. VIEW AND SEARCH PRODUCTS
    # ------------------------------------------------------

    def refresh_products(self):
        self.load_products()

    def load_products(self, search_text=""):
        try:
            for item in self.tree.get_children():
                self.tree.delete(item)

            if search_text:
                rows = database_query("""
                    SELECT id, name, quantity, expiry_date,
                           DATEDIFF(expiry_date, CURDATE()) AS days_left
                    FROM food_items
                    WHERE status='ACTIVE'
                    AND LOWER(name) LIKE LOWER(%s)
                    ORDER BY expiry_date ASC
                """, ("%" + search_text + "%",), fetch="all")
            else:
                rows = database_query("""
                    SELECT id, name, quantity, expiry_date,
                           DATEDIFF(expiry_date, CURDATE()) AS days_left
                    FROM food_items
                    WHERE status='ACTIVE'
                    ORDER BY expiry_date ASC
                """, fetch="all")

            for row in rows:
                days_left = row[4]

                if days_left < 0:
                    tag = "expired"
                    days_text = f"Expired ({abs(days_left)} days)"
                elif days_left <= ALERT_DAYS:
                    tag = "soon"
                    days_text = str(days_left)
                else:
                    tag = "normal"
                    days_text = str(days_left)

                self.tree.insert(
                    "",
                    tk.END,
                    values=(
                        row[0],
                        row[1],
                        row[2],
                        row[3].strftime("%d-%m-%Y"),
                        days_text
                    ),
                    tags=(tag,)
                )

            self.set_status(f"Showing {len(rows)} active product(s).")
            self.update_dashboard()

        except Error as error:
            messagebox.showerror("Database Error", str(error))

    def search_product(self):
        search_text = self.search_entry.get().strip()

        if not search_text:
            messagebox.showwarning(
                "Search",
                "Enter a product name to search."
            )
            return

        self.load_products(search_text)

        if not self.tree.get_children():
            messagebox.showinfo("Search", "No matching product found.")

    def show_all(self):
        self.search_entry.delete(0, tk.END)
        self.refresh_products()

    # ------------------------------------------------------
    # 9. EXPIRY MONITORING AND ALERT HISTORY
    # ------------------------------------------------------

    def check_one_product(self, item):
        product_id, name, expiry, alert_date, alert_count, last_time = item

        today = date.today()
        days_left = (expiry - today).days

        if days_left > ALERT_DAYS:
            return

        if days_left == 3:
            message = f"{name} expires in 3 days!"
        elif days_left == 2:
            message = f"{name} expires in 2 days!"
        elif days_left == 1:
            message = f"{name} expires tomorrow!"
        elif days_left == 0:
            message = f"{name} expires today!"
        else:
            message = f"{name} expiry date has passed!"

        if alert_date != today:
            alert_count = 0
            last_time = None

        if alert_count >= MAX_ALERTS_PER_DAY:
            return

        if alert_count == 1 and last_time:
            if datetime.now() - last_time < timedelta(
                hours=SECOND_ALERT_GAP_HOURS
            ):
                return

        # Save the alert history before sending the alert.
        # This prevents duplicate alerts if the app checks again.
        try:
            database_query("""
                UPDATE food_items
                SET alert_date=%s,
                    alert_count=%s,
                    last_alert_time=%s
                WHERE id=%s
            """, (
                today,
                alert_count + 1,
                datetime.now(),
                product_id
            ))

            alert_message(message)
            self.set_status(f"Expiry alert sent: {message}")

        except Error as error:
            print("Could not save alert history:", error)

    def check_all_expiry(self):
        try:
            products = database_query("""
                SELECT id, name, expiry_date,
                       alert_date, alert_count, last_alert_time
                FROM food_items
                WHERE status='ACTIVE'
            """, fetch="all")

            for item in products:
                self.check_one_product(item)

            self.update_dashboard()
            self.refresh_table_without_dashboard()

        except Error as error:
            self.set_status(f"Expiry check failed: {error}")

    def refresh_table_without_dashboard(self):
        # Refresh table but avoid repeatedly opening message boxes.
        try:
            for item in self.tree.get_children():
                self.tree.delete(item)

            rows = database_query("""
                SELECT id, name, quantity, expiry_date,
                       DATEDIFF(expiry_date, CURDATE())
                FROM food_items
                WHERE status='ACTIVE'
                ORDER BY expiry_date ASC
            """, fetch="all")

            for row in rows:
                days_left = row[4]

                if days_left < 0:
                    tag = "expired"
                    days_text = f"Expired ({abs(days_left)} days)"
                elif days_left <= ALERT_DAYS:
                    tag = "soon"
                    days_text = str(days_left)
                else:
                    tag = "normal"
                    days_text = str(days_left)

                self.tree.insert(
                    "",
                    tk.END,
                    values=(
                        row[0],
                        row[1],
                        row[2],
                        row[3].strftime("%d-%m-%Y"),
                        days_text
                    ),
                    tags=(tag,)
                )
        except Error as error:
            print("Table refresh error:", error)

    def manual_expiry_check(self):
        self.check_all_expiry()
        messagebox.showinfo(
            "Expiry Check",
            "Expiry monitoring completed."
        )

    def automatic_check(self):
        if self.closing:
            return

        self.check_all_expiry()
        self.monitor_job = self.root.after(
            CHECK_INTERVAL,
            self.automatic_check
        )

    # ------------------------------------------------------
    # 10. SELECTED PRODUCT
    # ------------------------------------------------------

    def selected_product_id(self):
        selected = self.tree.selection()

        if not selected:
            messagebox.showwarning(
                "Selection Required",
                "Please select a product from the table."
            )
            return None

        values = self.tree.item(selected[0], "values")
        return int(values[0])

    # ------------------------------------------------------
    # 11. DELETE PRODUCT
    # ------------------------------------------------------

    def delete_product(self):
        product_id = self.selected_product_id()

        if product_id is None:
            return

        confirm = messagebox.askyesno(
            "Confirm Delete",
            "Do you want to permanently delete this product?"
        )

        if not confirm:
            return

        try:
            database_query(
                "DELETE FROM food_items WHERE id=%s",
                (product_id,)
            )
            self.refresh_products()
            messagebox.showinfo(
                "Deleted",
                "Product deleted successfully."
            )
        except Error as error:
            messagebox.showerror("Delete Error", str(error))

    # ------------------------------------------------------
    # 12. RECORD FOOD WASTE
    # ------------------------------------------------------

    def record_waste(self):
        product_id = self.selected_product_id()

        if product_id is None:
            return

        try:
            product = database_query("""
                SELECT name
                FROM food_items
                WHERE id=%s AND status='ACTIVE'
            """, (product_id,), fetch="one")

            if not product:
                messagebox.showwarning(
                    "Not Found",
                    "The selected active product was not found."
                )
                return

            product_name = product[0]

            confirm = messagebox.askyesno(
                "Record Waste",
                f"Record '{product_name}' as wasted?"
            )

            if not confirm:
                return

            database_query("""
                UPDATE food_items
                SET status='WASTED'
                WHERE id=%s AND status='ACTIVE'
            """, (product_id,))

            self.refresh_products()

            messagebox.showinfo(
                "Success",
                "Food waste recorded successfully."
            )

        except Error as error:
            messagebox.showerror("Waste Error", str(error))

    # ------------------------------------------------------
    # 13. WASTE REPORT
    # ------------------------------------------------------

    def waste_report(self):
        try:
            rows = database_query("""
                SELECT id, name, quantity, expiry_date
                FROM food_items
                WHERE status='WASTED'
                ORDER BY id DESC
            """, fetch="all")

        except Error as error:
            messagebox.showerror("Report Error", str(error))
            return

        report = tk.Toplevel(self.root)
        report.title("Food Waste Report")
        report.geometry("720x430")
        report.configure(bg="#F1F5F4")

        tk.Label(
            report,
            text="FOOD WASTE REPORT",
            font=("Arial", 18, "bold"),
            bg="#F1F5F4",
            fg="#176B50"
        ).pack(pady=12)

        tk.Label(
            report,
            text=f"Total Wasted Products: {len(rows)}",
            font=("Arial", 11, "bold"),
            bg="#F1F5F4"
        ).pack(pady=5)

        columns = ("ID", "Name", "Quantity", "Expiry Date")
        report_tree = ttk.Treeview(
            report,
            columns=columns,
            show="headings"
        )

        for column in columns:
            report_tree.heading(column, text=column)
            report_tree.column(column, width=160, anchor="center")

        report_tree.pack(
            fill="both",
            expand=True,
            padx=15,
            pady=12
        )

        for row in rows:
            report_tree.insert(
                "",
                tk.END,
                values=(
                    row[0],
                    row[1],
                    row[2],
                    row[3].strftime("%d-%m-%Y")
                )
            )

        if not rows:
            tk.Label(
                report,
                text="No food waste has been recorded.",
                bg="#F1F5F4",
                font=("Arial", 11)
            ).pack(pady=10)

    # ------------------------------------------------------
    # 14. DELETE WASTE RECORDS
    # ------------------------------------------------------

    def delete_waste(self):
        confirm = messagebox.askyesno(
            "Confirm Delete",
            "Permanently delete ALL food waste records?"
        )

        if not confirm:
            return

        try:
            deleted = database_query("""
                DELETE FROM food_items
                WHERE status='WASTED'
            """)

            self.refresh_products()
            messagebox.showinfo(
                "Success",
                f"{deleted} waste record(s) deleted."
            )

        except Error as error:
            messagebox.showerror("Delete Error", str(error))

    # ------------------------------------------------------
    # 15. CLOSE APPLICATION
    # ------------------------------------------------------

    def close_application(self):
        self.closing = True

        if self.monitor_job is not None:
            try:
                self.root.after_cancel(self.monitor_job)
            except tk.TclError:
                pass

        self.root.destroy()


