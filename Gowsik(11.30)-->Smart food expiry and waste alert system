# 1. MYSQL CONFIGURATION
# ==========================================================

MYSQL_HOST = "localhost"
MYSQL_PORT = 3307
MYSQL_USER = "root"
MYSQL_PASSWORD = "ChooseYourNewPassword123!"
DATABASE_NAME = "expire_date"

CHECK_INTERVAL = 60_000       # 60 seconds
ALERT_DAYS = 3                # Alert when 3 days or less remain
MAX_ALERTS_PER_DAY = 2
SECOND_ALERT_GAP_HOURS = 6


# ==========================================================
# 2. DATABASE FUNCTIONS
# ==========================================================

def get_connection(include_database=True):
    """Create a fresh MySQL connection for each database operation."""
    settings = {
        "host": MYSQL_HOST,
        "port": MYSQL_PORT,
        "user": MYSQL_USER,
        "password": MYSQL_PASSWORD,
        "connection_timeout": 5
    }

    if include_database:
        settings["database"] = DATABASE_NAME

    return mysql.connector.connect(**settings)


def initialize_database():
    """Create the database and table if they do not already exist."""
    server_connection = None
    database_connection = None
    server_cursor = None
    database_cursor = None

    try:
        server_connection = get_connection(include_database=False)
        server_cursor = server_connection.cursor()
        server_cursor.execute(
            f"CREATE DATABASE IF NOT EXISTS `{DATABASE_NAME}`"
        )
        server_connection.commit()

        database_connection = get_connection(include_database=True)
        database_cursor = database_connection.cursor()

        database_cursor.execute("""
            CREATE TABLE IF NOT EXISTS food_items (
                id INT AUTO_INCREMENT PRIMARY KEY,
                name VARCHAR(100) NOT NULL,
                quantity VARCHAR(50) NOT NULL,
                expiry_date DATE NOT NULL,
                status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
                alert_date DATE DEFAULT NULL,
                alert_count INT NOT NULL DEFAULT 0,
                last_alert_time DATETIME DEFAULT NULL
            )
        """)

        # Add missing columns if this table was created by an older version.
        database_cursor.execute("SHOW COLUMNS FROM food_items")
        existing_columns = {row[0] for row in database_cursor.fetchall()}

        migrations = {
            "status": (
                "ALTER TABLE food_items "
                "ADD COLUMN status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'"
            ),
            "alert_date": (
                "ALTER TABLE food_items ADD COLUMN alert_date DATE DEFAULT NULL"
            ),
            "alert_count": (
                "ALTER TABLE food_items "
                "ADD COLUMN alert_count INT NOT NULL DEFAULT 0"
            ),
            "last_alert_time": (
                "ALTER TABLE food_items "
                "ADD COLUMN last_alert_time DATETIME DEFAULT NULL"
            )
        }

        for column_name, sql in migrations.items():
            if column_name not in existing_columns:
                database_cursor.execute(sql)

        database_connection.commit()
        print(
            f"MySQL connected successfully. "
            f"Database: {DATABASE_NAME}, Port: {MYSQL_PORT}"
        )

    finally:
        if server_cursor:
            server_cursor.close()
        if server_connection and server_connection.is_connected():
            server_connection.close()

        if database_cursor:
            database_cursor.close()
        if database_connection and database_connection.is_connected():
            database_connection.close()


def database_query(sql, values=None, fetch="none"):
    """
    Run a database operation using its own connection.
    fetch: 'one', 'all', or 'none'.
    """
    connection = None
    cursor = None

    try:
        connection = get_connection()
        cursor = connection.cursor()
        cursor.execute(sql, values or ())

        if fetch == "one":
            result = cursor.fetchone()
        elif fetch == "all":
            result = cursor.fetchall()
        else:
            result = cursor.rowcount

        connection.commit()
        return result

    except Error:
        if connection and connection.is_connected():
            connection.rollback()
        raise

    finally:
        if cursor:
            cursor.close()
        if connection and connection.is_connected():
            connection.close()


