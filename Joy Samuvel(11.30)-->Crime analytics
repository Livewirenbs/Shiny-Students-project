class CrimeDatabase:
    """Handles MySQL connection and database operations."""

    def server_connection(self):
        return mysql.connector.connect(**MYSQL_CONFIG)

    def database_connection(self):
        settings = dict(MYSQL_CONFIG)
        settings["database"] = DATABASE_NAME
        return mysql.connector.connect(**settings)

    def setup_database(self):
        conn = self.server_connection()
        try:
            cursor = conn.cursor()
            try:
                cursor.execute(
                    f"CREATE DATABASE IF NOT EXISTS `{DATABASE_NAME}` "
                    "CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"
                )
            finally:
                cursor.close()
        finally:
            conn.close()

        conn = self.database_connection()
        try:
            cursor = conn.cursor()
            try:
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS crimes (
                        crime_id INT AUTO_INCREMENT PRIMARY KEY,
                        crime_type VARCHAR(100) NOT NULL,
                        description TEXT,
                        location VARCHAR(200) NOT NULL,
                        incident_date DATETIME NOT NULL,
                        status ENUM(
                            'Pending',
                            'Under Investigation',
                            'Solved',
                            'Closed'
                        ) NOT NULL DEFAULT 'Pending',
                        severity ENUM(
                            'Low', 'Medium', 'High', 'Critical'
                        ) NOT NULL DEFAULT 'Medium',
                        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                            ON UPDATE CURRENT_TIMESTAMP,
                        INDEX idx_incident_date (incident_date),
                        INDEX idx_location (location),
                        INDEX idx_status (status),
                        INDEX idx_crime_type (crime_type)
                    )
                """)
                conn.commit()
            finally:
                cursor.close()
        finally:
            conn.close()

    def fetch_all(self, sql, params=()):
        conn = self.database_connection()
        try:
            cursor = conn.cursor(dictionary=True)
            try:
                cursor.execute(sql, params)
                return cursor.fetchall()
            finally:
                cursor.close()
        finally:
            conn.close()

    def execute(self, sql, params=()):
        conn = self.database_connection()
        try:
            cursor = conn.cursor()
            try:
                cursor.execute(sql, params)
                conn.commit()
                return cursor.lastrowid
            except Exception:
                conn.rollback()
                raise
            finally:
                cursor.close()
        finally:
            conn.close()

    def dashboard_stats(self):
        rows = self.fetch_all("""
            SELECT
                COUNT(*) AS total,
                COALESCE(SUM(DATE(incident_date) = CURDATE()), 0) AS today,
                COALESCE(SUM(status = 'Solved'), 0) AS solved,
                COALESCE(SUM(status IN
                    ('Pending', 'Under Investigation')), 0) AS pending
            FROM crimes
        """)
        return rows[0]

    def get_crimes(self, search_text=""):
        term = "%" + search_text + "%"
        # IMPORTANT: Double every % in DATE_FORMAT. The MySQL connector
        # uses %s-style parameter substitution for this parameterized query.
        return self.fetch_all("""
            SELECT crime_id, crime_type, location,
                   DATE_FORMAT(incident_date, '%Y-%m-%d %H:%i:%S')
                       AS incident_date,
                   status, severity, description
            FROM crimes
            WHERE crime_type LIKE %s
               OR location LIKE %s
               OR status LIKE %s
               OR CAST(crime_id AS CHAR) LIKE %s
            ORDER BY incident_date DESC
        """, (term, term, term, term))

    def get_type_summary(self):
        return self.fetch_all("""
            SELECT crime_type, COUNT(*) AS total
            FROM crimes
            GROUP BY crime_type
            ORDER BY total DESC
            LIMIT 8
        """)

    def get_area_summary(self):
        return self.fetch_all("""
            SELECT location, COUNT(*) AS total
            FROM crimes
            GROUP BY location
            ORDER BY total DESC
            LIMIT 8
        """)


