    def save_crime(self):
        crime_type = self.type_var.get().strip()
        location = self.location_var.get().strip()
        date_text = self.date_var.get().strip()

        if not crime_type or not location or not date_text:
            messagebox.showwarning(
                "Missing Information",
                "Enter crime type, location and incident date."
            )
            return

        try:
            datetime.strptime(date_text, "%Y-%m-%d %H:%M:%S")
        except ValueError:
            messagebox.showerror(
                "Invalid Date",
                "Enter date as YYYY-MM-DD HH:MM:SS."
            )
            return

        description = self.description_text.get("1.0", "end").strip()

        try:
            self.db.execute("""
                INSERT INTO crimes
                (crime_type, description, location, incident_date, status, severity)
                VALUES (%s, %s, %s, %s, %s, %s)
            """, (
                crime_type,
                description,
                location,
                date_text,
                self.status_var.get(),
                self.severity_var.get()
            ))

            messagebox.showinfo(
                "Saved", "Crime record saved successfully."
            )

            self.type_var.set("")
            self.location_var.set("")
            self.date_var.set(
                datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            )
            self.status_var.set("Pending")
            self.severity_var.set("Medium")
            self.description_text.delete("1.0", "end")
            self.refresh_all()
        except Error as exc:
            self.database_error(exc)

    def refresh_records(self):
        rows = self.db.get_crimes(self.search_var.get().strip())
        self.records_tree.delete(*self.records_tree.get_children())
        self.record_descriptions = {}

        for row in rows:
            record_id = str(row["crime_id"])
            self.records_tree.insert(
                "", "end", iid=record_id,
                values=(
                    row["crime_id"],
                    row["crime_type"],
                    row["location"],
                    row["incident_date"],
                    row["status"],
                    row["severity"]
                )
            )
            self.record_descriptions[record_id] = (
                row.get("description") or "(No description)"
            )

    def clear_search(self):
        self.search_var.set("")
        self.refresh_records()

    def show_selected_description(self, _event=None):
        selected = self.records_tree.selection()
        if selected:
            description = self.record_descriptions.get(
                selected[0], "(No description)"
            )
            self.description_label.config(
                text="Description: " + description
            )

    def selected_id(self):
        selected = self.records_tree.selection()
        if not selected:
            messagebox.showwarning(
                "Select Record", "Select a crime record first."
            )
            return None
        return int(selected[0])

    def update_status(self):
        crime_id = self.selected_id()
        if crime_id is None:
            return

        dialog = tk.Toplevel(self.root)
        dialog.title("Update Case Status")
        dialog.geometry("320x160")
        dialog.transient(self.root)
        dialog.grab_set()

        tk.Label(
            dialog,
            text="Choose new case status:",
            font=("Arial", 11, "bold")
        ).pack(pady=14)

        status = tk.StringVar(value="Under Investigation")
        ttk.Combobox(
            dialog,
            textvariable=status,
            values=[
                "Pending", "Under Investigation", "Solved", "Closed"
            ],
            state="readonly",
            width=25
        ).pack(pady=5)

        def save_status():
            try:
                self.db.execute(
                    "UPDATE crimes SET status=%s WHERE crime_id=%s",
                    (status.get(), crime_id)
                )
                dialog.destroy()
                self.refresh_all()
            except Error as exc:
                messagebox.showerror(
                    "Database Error", str(exc), parent=dialog
                )

        ttk.Button(
            dialog, text="Save Status", command=save_status
        ).pack(pady=12)

    def delete_selected(self):
        crime_id = self.selected_id()
        if crime_id is None:
            return

        confirmed = messagebox.askyesno(
            "Confirm Delete",
            f"Delete crime record #{crime_id}? This cannot be undone."
        )
        if not confirmed:
            return

        try:
            self.db.execute(
                "DELETE FROM crimes WHERE crime_id=%s",
                (crime_id,)
            )
            self.refresh_all()
        except Error as exc:
            self.database_error(exc)

    def export_csv(self):
        try:
            rows = self.db.get_crimes(self.search_var.get().strip())
            if not rows:
                messagebox.showinfo(
                    "Export", "There are no records to export."
                )
                return

            path = filedialog.asksaveasfilename(
                defaultextension=".csv",
                filetypes=[("CSV files", "*.csv")],
                initialfile="crime_records.csv"
            )
            if not path:
                return

            with open(
                path, "w", newline="", encoding="utf-8-sig"
            ) as output_file:
                writer = csv.DictWriter(
                    output_file, fieldnames=list(rows[0].keys())
                )
                writer.writeheader()
                writer.writerows(rows)

            messagebox.showinfo(
                "Export Complete", "CSV file exported successfully."
            )
        except (Error, OSError) as exc:
            messagebox.showerror("Export Error", str(exc))

    def refresh_dashboard(self):
        stats = self.db.dashboard_stats()
        values = [
            stats.get("total") or 0,
            stats.get("today") or 0,
            stats.get("solved") or 0,
            stats.get("pending") or 0,
        ]

        for label, value in zip(self.stat_labels, values):
            label.config(text=str(value))

        # Uppercase %S represents seconds and avoids a %s parameter token.
        rows = self.db.fetch_all("""
            SELECT crime_id, crime_type, location,
                   DATE_FORMAT(incident_date, '%Y-%m-%d %H:%i:%S')
                       AS incident_date,
                   status, severity
            FROM crimes
            ORDER BY incident_date DESC
            LIMIT 10
        """)

        self.recent_tree.delete(*self.recent_tree.get_children())
        for row in rows:
            self.recent_tree.insert(
                "", "end",
                values=(
                    row["crime_id"],
                    row["crime_type"],
                    row["location"],
                    row["incident_date"],
                    row["status"],
                    row["severity"]
                )
            )

    def refresh_analytics(self):
        type_rows = self.db.get_type_summary()
        area_rows = self.db.get_area_summary()

        if self.chart_canvas is not None:
            self.chart_canvas.get_tk_widget().destroy()
            self.chart_canvas = None

        figure = Figure(figsize=(10, 4.8), dpi=100)
        type_axis = figure.add_subplot(121)
        area_axis = figure.add_subplot(122)

        if type_rows:
            names = [row["crime_type"] for row in type_rows]
            counts = [int(row["total"]) for row in type_rows]
            type_axis.bar(names, counts)
            type_axis.set_title("Crimes by Type")
            type_axis.set_ylabel("Number of Cases")
            type_axis.tick_params(axis="x", rotation=35, labelsize=8)
        else:
            type_axis.text(
                0.5, 0.5, "No crime data available",
                ha="center", va="center"
            )
            type_axis.set_title("Crimes by Type")
            type_axis.set_axis_off()

        if area_rows:
            areas = [row["location"] for row in area_rows][::-1]
            counts = [int(row["total"]) for row in area_rows][::-1]
            area_axis.barh(areas, counts)
            area_axis.set_title("Top Crime Locations")
            area_axis.set_xlabel("Number of Cases")
            area_axis.tick_params(axis="y", labelsize=8)
        else:
            area_axis.text(
                0.5, 0.5, "No crime data available",
                ha="center", va="center"
            )
            area_axis.set_title("Top Crime Locations")
            area_axis.set_axis_off()

        figure.tight_layout()
        self.chart_canvas = FigureCanvasTkAgg(
            figure, master=self.chart_frame
        )
        self.chart_canvas.draw()
        self.chart_canvas.get_tk_widget().pack(
            fill="both", expand=True
        )

    def refresh_all(self, show_errors=False):
        try:
            self.refresh_dashboard()
            self.refresh_records()
            self.refresh_analytics()
            self.connection_label.config(
                text="● MySQL Connected", fg="#7ee0ad"
            )
        except Error as exc:
            self.connection_label.config(
                text="● MySQL Disconnected", fg="#ff8b8b"
            )
            if show_errors:
                self.database_error(exc)

    def database_error(self, exc):
        self.connection_label.config(
            text="● MySQL Disconnected", fg="#ff8b8b"
        )
        messagebox.showerror(
            "MySQL Error",
            f"{exc}\n\nCheck that MySQL Server is running and that "
            "MYSQL_CONFIG contains the correct username and password."
        )

    def schedule_refresh(self):
        self.refresh_job = self.root.after(
            REFRESH_INTERVAL_MS, self.periodic_refresh
        )

    def periodic_refresh(self):
        try:
            self.refresh_dashboard()
            self.refresh_records()
            self.refresh_analytics()
            self.connection_label.config(
                text="● MySQL Connected", fg="#7ee0ad"
            )
        except Error:
            self.connection_label.config(
                text="● MySQL Disconnected", fg="#ff8b8b"
            )
        finally:
            if self.root.winfo_exists():
                self.schedule_refresh()

    def close(self):
        if self.refresh_job is not None:
            try:
                self.root.after_cancel(self.refresh_job)
            except tk.TclError:
                pass
        self.root.destroy()


if __name__ == "__main__":
    root = tk.Tk()

    try:
        app = CrimeAnalyticsApp(root)
        root.protocol("WM_DELETE_WINDOW", app.close)
        root.mainloop()
    except Error as exc:
        messagebox.showerror(
            "Startup / MySQL Error",
            f"{exc}\n\nVerify MYSQL_CONFIG at the top of this Python file."
        )
        root.destroy()
    except Exception as exc:
        messagebox.showerror("Application Error", str(exc))
        root.destroy()

