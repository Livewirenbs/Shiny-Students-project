def submit_report():
    category = category_box.get()
    subject = subject_entry.get().strip()
    age = age_entry.get().strip()
    location = location_entry.get().strip()
    incident_date = date_entry.get().strip()
    description = description_text.get("1.0", tk.END).strip()

    if not subject or not location or not description:
        messagebox.showwarning(
            "Missing Information",
            "Please enter the subject, location and description."
        )
        return

    current_time = datetime.now()

    try:
        cursor.execute("""
        INSERT INTO reports (
            category, subject, age, location,
            incident_date, description, status,
            officer_update, created_at, updated_at
        )
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
        """, (
            category,
            subject,
            age,
            location,
            incident_date,
            description,
            "Pending",
            "Waiting for officer review",
            current_time,
            current_time
        ))

        conn.commit()
        report_id = cursor.lastrowid

        play_beep()

        messagebox.showinfo(
            "Report Submitted",
            f"Your report was submitted successfully!\n\n"
            f"Your Report ID is: {report_id}\n\n"
            "Please save this ID to check your report status."
        )

        subject_entry.delete(0, tk.END)
        age_entry.delete(0, tk.END)
        location_entry.delete(0, tk.END)
        description_text.delete("1.0", tk.END)

    except Error as error:
        conn.rollback()
        messagebox.showerror("Database Error", str(error))


