def check_report_status():
    report_id = report_id_entry.get().strip()

    if not report_id.isdigit():
        messagebox.showwarning("Invalid ID", "Enter a valid Report ID.")
        return

    try:
        cursor.execute("""
        SELECT category, status, officer_update, updated_at
        FROM reports
        WHERE id = %s
        """, (int(report_id),))

        report = cursor.fetchone()

        if report:
            category, status, officer_update, updated_at = report

            status_result.config(
                text=(
                    f"Report ID: {report_id}\n"
                    f"Category: {category}\n"
                    f"Current Status: {status}\n"
                    f"Officer Update: {officer_update}\n"
                    f"Last Updated: {updated_at}"
                )
            )
        else:
            status_result.config(text="No report found with this ID.")

    except Error as error:
        messagebox.showerror("Database Error", str(error))


