def open_officer_dashboard():
    dashboard = tk.Toplevel(root)
    dashboard.title("RakshaTN - Officer Dashboard")
    dashboard.geometry("1100x650")

    tk.Label(
        dashboard,
        text="OFFICER DASHBOARD",
        font=("Arial", 20, "bold"),
        fg="#17365d"
    ).pack(pady=12)

    columns = (
        "ID", "Category", "Subject", "Location",
        "Status", "Created"
    )

    table = ttk.Treeview(
        dashboard,
        columns=columns,
        show="headings",
        height=12
    )

    for column in columns:
        table.heading(column, text=column)
        table.column(column, width=145)

    table.pack(fill="x", padx=12, pady=10)

    selected_label = tk.Label(
        dashboard,
        text="Select a report from the table.",
        font=("Arial", 10)
    )
    selected_label.pack(pady=5)

    update_frame = tk.LabelFrame(
        dashboard,
        text="Update Case",
        padx=12,
        pady=10
    )
    update_frame.pack(fill="x", padx=12, pady=10)

    tk.Label(update_frame, text="New Status").grid(
        row=0, column=0, sticky="w", pady=5
    )

    status_box = ttk.Combobox(
        update_frame,
        values=[
            "Viewed by Officer",
            "Action Started",
            "Referred to Authorities",
            "Closed"
        ],
        state="readonly",
        width=28
    )
    status_box.grid(row=0, column=1, padx=8, pady=5)
    status_box.set("Viewed by Officer")

    tk.Label(update_frame, text="Officer Update").grid(
        row=1, column=0, sticky="nw", pady=5
    )

    update_text = tk.Text(update_frame, width=55, height=4)
    update_text.grid(row=1, column=1, padx=8, pady=5)

    selected_report_id = [None]

    def refresh_reports():
        try:
            table.delete(*table.get_children())

            cursor.execute("""
            SELECT id, category, subject, location, status, created_at
            FROM reports
            ORDER BY id DESC
            """)

            for report in cursor.fetchall():
                table.insert("", tk.END, values=report)

        except Error as error:
            messagebox.showerror("Database Error", str(error))

    def select_report(event=None):
        selected = table.selection()

        if not selected:
            return

        values = table.item(selected[0], "values")
        selected_report_id[0] = int(values[0])

        try:
            cursor.execute("""
            SELECT description, officer_update
            FROM reports
            WHERE id = %s
            """, (selected_report_id[0],))

            details = cursor.fetchone()

            if details:
                description, officer_update = details

                selected_label.config(
                    text=(
                        f"Selected Report ID: {selected_report_id[0]}\n"
                        f"Description: {description}"
                    )
                )

                update_text.delete("1.0", tk.END)
                update_text.insert(tk.END, officer_update or "")

        except Error as error:
            messagebox.showerror("Database Error", str(error))

    table.bind("<<TreeviewSelect>>", select_report)

    def save_case_update():
        report_id = selected_report_id[0]

        if report_id is None:
            messagebox.showwarning(
                "Select Report",
                "Please select a report first."
            )
            return

        new_status = status_box.get()
        officer_update = update_text.get("1.0", tk.END).strip()

        if not officer_update:
            messagebox.showwarning(
                "Missing Update",
                "Please enter an officer update."
            )
            return

        current_time = datetime.now()

        try:
            cursor.execute("""
            UPDATE reports
            SET status = %s,
                officer_update = %s,
                updated_at = %s
            WHERE id = %s
            """, (
                new_status,
                officer_update,
                current_time,
                report_id
            ))

            conn.commit()

            messagebox.showinfo(
                "Updated",
                f"Report {report_id} has been updated."
            )

            refresh_reports()

        except Error as error:
            conn.rollback()
            messagebox.showerror("Database Error", str(error))

    tk.Button(
        update_frame,
        text="SAVE CASE UPDATE",
        command=save_case_update,
        bg="#176b45",
        fg="white",
        width=22
    ).grid(row=2, column=1, sticky="w", pady=10)

    tk.Button(
        dashboard,
        text="REFRESH REPORTS",
        command=refresh_reports,
        bg="#176b9b",
        fg="white"
    ).pack(pady=5)

    # Check for newly submitted reports every 3 seconds.
    cursor.execute("SELECT MAX(id) FROM reports")
    last_seen_id = [cursor.fetchone()[0] or 0]

    def check_new_reports():
        if not dashboard.winfo_exists():
            return

        try:
            cursor.execute("SELECT MAX(id) FROM reports")
            latest_id = cursor.fetchone()[0] or 0

            if latest_id > last_seen_id[0]:
                last_seen_id[0] = latest_id
                refresh_reports()
                play_beep()

                messagebox.showinfo(
                    "New Report Alert",
                    "A new citizen report has been submitted!"
                )

        except Error as error:
            messagebox.showerror("Database Error", str(error))

        if dashboard.winfo_exists():
            dashboard.after(3000, check_new_reports)

    refresh_reports()
    dashboard.after(3000, check_new_reports)


