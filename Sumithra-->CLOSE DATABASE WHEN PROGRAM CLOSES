MYSQL_HOST = "localhost"
MYSQL_USER = "root"
MYSQL_PASSWORD = "sumithra`"  # Replace with your MySQL password
DATABASE_NAME = "rakshatn_db"


def connect_database():
    """Create the database if it does not exist, then connect to it."""
    server = None

    try:
        server = mysql.connector.connect(
            host=MYSQL_HOST,
            user=MYSQL_USER,
            password=MYSQL_PASSWORD
        )

        server_cursor = server.cursor()
        server_cursor.execute(
            f"CREATE DATABASE IF NOT EXISTS {DATABASE_NAME}"
        )
        server_cursor.close()
        server.close()
        server = None

        connection = mysql.connector.connect(
            host=MYSQL_HOST,
            user=MYSQL_USER,
            password=MYSQL_PASSWORD,
            database=DATABASE_NAME
        )

        return connection

    except Error as error:
        if server is not None and server.is_connected():
            server.close()
        raise RuntimeError(
            "Could not connect to MySQL. Check that MySQL Server is running "
            "and that your username and password are correct.\n\n"
            + str(error)
        )


try:
    conn = connect_database()
    cursor = conn.cursor(buffered=True)
except (Error, RuntimeError) as error:
    print("DATABASE CONNECTION ERROR:")
    print(error)
    raise SystemExit(1)


