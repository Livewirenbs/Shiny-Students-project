def train_face_recognizer():
    if not hasattr(cv2, "face"):
        messagebox.showerror(
            "OpenCV Error",
            "LBPH recognizer is unavailable. Install opencv-contrib-python."
        )
        return None, {}

    recognizer = cv2.face.LBPHFaceRecognizer_create()
    faces, labels, label_to_student = [], [], {}

    with connect_db() as conn:
        students = conn.execute(
            "SELECT id,name,photo_path FROM students"
        ).fetchall()

    for student_id, name, photo_path in students:
        if not photo_path or not os.path.exists(photo_path):
            continue

        image = cv2.imread(photo_path)
        if image is None:
            continue

        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        detected = face_cascade.detectMultiScale(
            gray, scaleFactor=1.1, minNeighbors=5, minSize=(80, 80)
        )

        if len(detected) == 0:
            continue

        x, y, w, h = detected[0]
        face = cv2.resize(gray[y:y+h, x:x+w], (200, 200))
        faces.append(face)
        labels.append(student_id)
        label_to_student[student_id] = name

    if not faces:
        return None, {}

    recognizer.train(faces, np.array(labels))
    return recognizer, label_to_student

def mark_attendance(student_id):
    today = date.today().isoformat()
    current_time = datetime.now().strftime("%H:%M:%S")

    try:
        with connect_db() as conn:
            conn.execute("""
                INSERT INTO attendance
                (student_id,attendance_date,attendance_time,status)
                VALUES (?,?,?,'Present')
            """, (student_id, today, current_time))

        audit("ATTENDANCE_MARKED", f"Student ID {student_id}")
        return True

    except IntegrityError:
        return False

def start_face_recognition():
    recognizer, label_to_student = train_face_recognizer()

    if recognizer is None:
        messagebox.showwarning(
            "No Training Data", "Register students with clear face photos first."
        )
        return

    camera = cv2.VideoCapture(0)
    if not camera.isOpened():
        messagebox.showerror(
            "Camera Error", "Unable to open webcam. Check camera permission."
        )
        return

    recognized_ids = set()
    unknown_alerted = False
    MATCH_THRESHOLD = 75

    try:
        while True:
            success, frame = camera.read()
            if not success:
                break

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            detected = face_cascade.detectMultiScale(
                gray, scaleFactor=1.1, minNeighbors=5, minSize=(80, 80)
            )

            for x, y, w, h in detected:
                face = cv2.resize(gray[y:y+h, x:x+w], (200, 200))
                label, confidence = recognizer.predict(face)

                if confidence < MATCH_THRESHOLD and label in label_to_student:
                    name = label_to_student[label]
                    color = (0, 180, 0)
                    display_text = f"{name} ({max(0, 100-confidence):.0f}%)"

                    if label not in recognized_ids:
                        recognized_ids.add(label)
                        if mark_attendance(label):
                            print(f"Attendance marked: {name}")
                        else:
                            print(f"Already marked today: {name}")
                else:
                    color = (0, 0, 255)
                    display_text = "Unknown Face"
                    if not unknown_alerted:
                        print("Unknown face detected!")
                        unknown_alerted = True

                cv2.rectangle(frame, (x, y), (x+w, y+h), color, 2)
                cv2.putText(
                    frame, display_text, (x, y-10),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2
                )

            cv2.putText(
                frame, "Press Q to close", (20, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2
            )
            cv2.imshow("FaceTrack - Face Recognition", frame)

            if cv2.waitKey(1) & 0xFF == ord("q"):
                break

    finally:
        camera.release()
        cv2.destroyAllWindows()
        show_dashboard()

