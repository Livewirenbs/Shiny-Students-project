def create_tree(parent, columns, headings, height=15):
    tree = ttk.Treeview(
        parent, columns=columns, show="headings", height=height
    )
    for col, heading in zip(columns, headings):
        tree.heading(col, text=heading)
        tree.column(col, width=160)
    return tree

