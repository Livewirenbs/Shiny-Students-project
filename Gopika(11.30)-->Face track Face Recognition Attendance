def export_report():
    file_path = filedialog.asksaveasfilename(
        title="Export Attendance Report",
        defaultextension=".csv",
        filetypes=[("CSV File", "*.csv"), ("PDF File", "*.pdf")]
    )
    if not file_path:
        return

    with connect_db() as conn:
        rows = conn.execute("""
            SELECT students.id,students.name,students.department,
                   students.year,attendance.attendance_date,
                   attendance.attendance_time,attendance.status
            FROM attendance
            JOIN students ON students.id=attendance.student_id
            ORDER BY attendance.attendance_date DESC
        """).fetchall()

    headers = [
        "Student ID", "Name", "Department", "Year",
        "Date", "Time", "Status"
    ]

    try:
        if file_path.lower().endswith(".pdf"):
            pdf = canvas.Canvas(file_path, pagesize=A4)
            width, height = A4
            pdf.setFont("Helvetica-Bold", 16)
            pdf.drawString(40, height-40, "FaceTrack Attendance Report")

            pdf.setFont("Helvetica-Bold", 8)
            y = height - 75
            pdf.drawString(
                40, y, "ID | Name | Department | Year | Date | Time | Status"
            )
            y -= 20
            pdf.setFont("Helvetica", 8)

            for row in rows:
                line = " | ".join(str(value or "") for value in row)
                if y < 50:
                    pdf.showPage()
                    pdf.setFont("Helvetica", 8)
                    y = height - 50

                pdf.drawString(40, y, line[:115])
                y -= 15

            pdf.save()

        else:
            with open(file_path, "w", newline="", encoding="utf-8") as file:
                writer = csv.writer(file)
                writer.writerow(headers)
                writer.writerows(rows)

        audit("REPORT_EXPORTED", file_path)
        messagebox.showinfo(
            "Export Complete", f"Report saved successfully:\n{file_path}"
        )

    except Exception as error:
        messagebox.showerror("Export Error", str(error))

# ================= DATABASE BACKUP =================

def backup_database():
    """Export MySQL table definitions and rows to a .sql backup file."""
    backup_name = "facetrack_backup_" + datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    ) + ".sql"
    backup_path = os.path.join(BACKUP_DIR, backup_name)
    connection = None

    try:
        connection = mysql.connector.connect(**DB_CONFIG)
        cursor = connection.cursor()
        tables = ["students", "attendance", "admins", "audit_log"]

        with open(backup_path, "w", encoding="utf-8") as file:
            file.write("CREATE DATABASE IF NOT EXISTS facetrack;\nUSE facetrack;\n\n")
            file.write("SET FOREIGN_KEY_CHECKS=0;\n")
            for table in tables:
                cursor.execute(f"SHOW CREATE TABLE `{table}`")
                create_row = cursor.fetchone()
                file.write("\nDROP TABLE IF EXISTS `" + table + "`;\n")
                file.write(create_row[1] + ";\n")

                cursor.execute(f"SELECT * FROM `{table}`")
                rows = cursor.fetchall()
                for row in rows:
                    values = []
                    for value in row:
                        if value is None:
                            values.append("NULL")
                        elif isinstance(value, (int, float)):
                            values.append(str(value))
                        elif isinstance(value, (datetime, date)):
                            values.append("'" + value.isoformat() + "'")
                        else:
                            escaped = str(value).replace("\\", "\\\\").replace("'", "\\'")
                            values.append("'" + escaped + "'")
                    file.write(
                        f"INSERT INTO `{table}` VALUES ({', '.join(values)});\n"
                    )
            file.write("\nSET FOREIGN_KEY_CHECKS=1;\n")

        audit("DATABASE_BACKUP", backup_path)
        messagebox.showinfo(
            "Backup Complete", f"MySQL backup created:\n{backup_path}"
        )
    except Exception as error:
        messagebox.showerror("Backup Error", str(error))
    finally:
        if connection and connection.is_connected():
            connection.close()

