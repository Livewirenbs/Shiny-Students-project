class DatabaseConnection:
    """Small adapter that keeps the existing app's execute/fetch style."""
    def __init__(self):
        self.connection = mysql.connector.connect(**DB_CONFIG)

    def __enter__(self):
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        try:
            if exc_type is None:
                self.connection.commit()
            else:
                self.connection.rollback()
        finally:
            self.connection.close()

    def execute(self, query, params=None):
        cursor = self.connection.cursor()
        cursor.execute(query.replace("?", "%s"), params or ())
        return cursor


def connect_db():
    return DatabaseConnection()

def hash_password(password):
    return hashlib.sha256(password.encode()).hexdigest()

def initialize_database():
    """Create required MySQL tables and the default admin if not present."""
    with connect_db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS students (
                id INT AUTO_INCREMENT PRIMARY KEY,
                name VARCHAR(100) NOT NULL,
                department VARCHAR(100),
                year VARCHAR(30),
                face_id VARCHAR(100) UNIQUE,
                photo_path TEXT,
                created_at DATETIME
            ) ENGINE=InnoDB
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS attendance (
                id INT AUTO_INCREMENT PRIMARY KEY,
                student_id INT NOT NULL,
                attendance_date DATE NOT NULL,
                attendance_time TIME NOT NULL,
                status VARCHAR(20) DEFAULT 'Present',
                CONSTRAINT fk_attendance_student
                    FOREIGN KEY (student_id) REFERENCES students(id)
                    ON DELETE CASCADE,
                UNIQUE KEY uq_student_attendance_date (student_id, attendance_date)
            ) ENGINE=InnoDB
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS admins (
                id INT AUTO_INCREMENT PRIMARY KEY,
                username VARCHAR(50) UNIQUE,
                password VARCHAR(255)
            ) ENGINE=InnoDB
        """)
        conn.execute("""
            CREATE TABLE IF NOT EXISTS audit_log (
                id INT AUTO_INCREMENT PRIMARY KEY,
                action VARCHAR(100),
                details TEXT,
                log_time DATETIME
            ) ENGINE=InnoDB
        """)

        count = conn.execute("SELECT COUNT(*) FROM admins").fetchone()[0]
        if count == 0:
            conn.execute(
                "INSERT INTO admins(username,password) VALUES (?,?)",
                ("admin", hash_password("admin123"))
            )

def audit(action, details):
    with connect_db() as conn:
        conn.execute(
            "INSERT INTO audit_log(action,details,log_time) VALUES (?,?,?)",
            (action, details, datetime.now().strftime("%Y-%m-%d %H:%M:%S"))
        )

def get_student_count():
    with connect_db() as conn:
        return conn.execute("SELECT COUNT(*) FROM students").fetchone()[0]

def get_present_count():
    with connect_db() as conn:
        return conn.execute(
            "SELECT COUNT(*) FROM attendance WHERE attendance_date=?",
            (date.today().isoformat(),)
        ).fetchone()[0]

def get_absent_count():
    return max(0, get_student_count() - get_present_count())

def get_attendance_percentage():
    total = get_student_count()
    return round(get_present_count() / total * 100, 2) if total else 0

