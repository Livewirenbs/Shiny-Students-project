def show_attendance_reports():
    clear_window()
    make_label(root, "Attendance Reports", 22, True, DARK).pack(pady=15)

    filter_frame = tk.Frame(root, bg=BG)
    filter_frame.pack(pady=10)

    make_label(filter_frame, "Date (YYYY-MM-DD):").pack(side="left", padx=5)
    date_entry = tk.Entry(filter_frame, width=15)
    date_entry.insert(0, date.today().isoformat())
    date_entry.pack(side="left", padx=5)

    tree = create_tree(
        root, ("name", "department", "date", "time", "status"),
        ("Student Name", "Department", "Date", "Time", "Status"), 18
    )
    tree.pack(fill="both", expand=True, padx=20, pady=15)

    def validate_date():
        selected_date = date_entry.get().strip()
        try:
            datetime.strptime(selected_date, "%Y-%m-%d")
            return selected_date
        except ValueError:
            messagebox.showerror(
                "Invalid Date", "Enter date in YYYY-MM-DD format."
            )
            return None

    def clear_tree():
        tree.delete(*tree.get_children())

    def load_report():
        selected_date = validate_date()
        if not selected_date:
            return

        clear_tree()
        with connect_db() as conn:
            rows = conn.execute("""
                SELECT students.name,students.department,
                       attendance.attendance_date,
                       attendance.attendance_time,attendance.status
                FROM attendance
                JOIN students ON students.id=attendance.student_id
                WHERE attendance.attendance_date=?
                ORDER BY students.name
            """, (selected_date,)).fetchall()

        for row in rows:
            tree.insert("", "end", values=row)

    def show_absent_students():
        selected_date = validate_date()
        if not selected_date:
            return

        clear_tree()
        with connect_db() as conn:
            rows = conn.execute("""
                SELECT name,department FROM students
                WHERE id NOT IN (
                    SELECT student_id FROM attendance
                    WHERE attendance_date=?
                )
                ORDER BY name
            """, (selected_date,)).fetchall()

        for name, department in rows:
            tree.insert(
                "", "end",
                values=(name, department, selected_date, "-", "Absent")
            )

    def show_monthly_report():
        selected_date = validate_date()
        if not selected_date:
            return

        month = selected_date[:7]
        clear_tree()

        with connect_db() as conn:
            rows = conn.execute("""
                SELECT students.name,students.department,
                       attendance.attendance_date,
                       attendance.attendance_time,attendance.status
                FROM attendance
                JOIN students ON students.id=attendance.student_id
                WHERE attendance.attendance_date LIKE ?
                ORDER BY attendance.attendance_date DESC
            """, (month + "%",)).fetchall()

        for row in rows:
            tree.insert("", "end", values=row)

    buttons = tk.Frame(root, bg=BG)
    buttons.pack(pady=10)

    for text, command, color in [
        ("Search Date", load_report, BLUE),
        ("Absent Report", show_absent_students, RED),
        ("Monthly Report", show_monthly_report, ORANGE),
        ("Back", show_dashboard, DARK)
    ]:
        make_button(buttons, text, command, color).pack(side="left", padx=5)

    load_report()

