from database import get_connection

def get_all_buses():

    con = get_connection()
    cur = con.cursor()

    cur.execute("""
        SELECT bus_id, bus_number, bus_name
        FROM buses
        ORDER BY bus_id
    """)

    records = cur.fetchall()

    cur.close()
    con.close()

    return records


def add_bus(number, name, capacity):

    con = get_connection()
    cur = con.cursor()

    cur.execute("""
        INSERT INTO buses
        (bus_number, bus_name, capacity)
        VALUES (%s, %s, %s)
    """, (number, name, capacity))

    con.commit()

    cur.close()
    con.close()

